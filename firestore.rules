rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /user_profiles/{document} {
      allow read, write: if true;
    }
    match /wallet_transactions/{document} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
